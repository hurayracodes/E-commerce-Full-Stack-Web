# backend/.env.example  ->  copy karke backend/.env banayein aur apni values bharein.
# Is file mein sirf placeholders hain, asli secrets nahi: ise GitHub par aur AI ko dikhana safe hai.

PORT=3000

# Local MongoDB (bina Atlas ke chalane ke liye). Atlas ho to uska mongodb+srv://... link rakhein.
MONGO_URI=mongodb://127.0.0.1:27017/msee

# Koi bhi lambi random string (kam az kam 32 characters). Live site ke liye alag rakhein.
JWT_SECRET=local_only_change_this_to_a_long_random_string

# Frontend ka address (Vite ka port). Live par Vercel ka URL; comma se kai de sakte hain.
CLIENT_URL=http://localhost:5173

# Cloudinary (images ke liye) - cloudinary.com ke free account se asli values chahiye
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sirf "node createAdmin.js" ke liye
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
